@model MvcCv.Models.Entity.TblEgitim
@{
    ViewBag.Title = "EgitimGetir";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<br />
<br />
<h3>Eğitim Düzenleme Sayfası</h3>

<form method="post">
    @Html.Label("Başlık (Okul Adı / Derece)")
    @Html.TextBoxFor(x => x.Baslik, new { @class = "form-control" })
    @Html.ValidationMessageFor(x => x.Baslik, "", new { @class = "text-danger" })
    <br />

    @Html.Label("Alt Başlık 1 (Fakülte / Bölüm)")
    @Html.TextBoxFor(x => x.AltBaslik1, new { @class = "form-control" })
    @Html.ValidationMessageFor(x => x.AltBaslik1, "", new { @class = "text-danger" })
    <br />

    @Html.Label("Alt Başlık 2 (Açıklama / Detay)")
    @Html.TextBoxFor(x => x.AltBaslik2, new { @class = "form-control" })
    @Html.ValidationMessageFor(x => x.AltBaslik2, "", new { @class = "text-danger" })
    <br />

    @Html.Label("Genel Not Ortalaması (GNO)")
    @Html.TextBoxFor(x => x.GNO, new { @class = "form-control" })
    @Html.ValidationMessageFor(x => x.GNO, "", new { @class = "text-danger" })
    <br />

    @Html.Label("Tarih Aralığı")
    @Html.TextBoxFor(x => x.Tarih, new { @class = "form-control" })
    @Html.ValidationMessageFor(x => x.Tarih, "", new { @class = "text-danger" })
    <br />
    <button type="submit" class="btn btn-success">Güncelle</button>
</form>