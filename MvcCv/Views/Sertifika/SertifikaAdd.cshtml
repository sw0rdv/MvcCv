@model MvcCv.Models.Entity.TblSertifikalarım
@{
    ViewBag.Title = "SertifikaAdd";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<br />
<br />
<br />
<h3>Yeni Sertifika Ekleme Sayfası</h3>

<form method="post">
    @Html.Label("Sertifika İsmi")
    @Html.TextBoxFor(x => x.Aciklama, new { @class = "form-control", placeholder = "Sertifika Ismi" })
    @Html.ValidationMessageFor(x => x.Aciklama, "", new { @class = "text-danger" })
    <br />

    @Html.Label("Tarih")
    @Html.TextBoxFor(x => x.Tarih, new { @class = "form-control", placeholder = "Tarih" })
    @Html.ValidationMessageFor(x => x.Tarih, "", new { @class = "text-danger" })
    <br />

    <button type="submit" class="btn btn-primary">Kaydet</button>
</form>

