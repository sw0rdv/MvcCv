@model MvcCv.Models.Entity.TblYetenekler

@{
    ViewBag.Title = "YetenekEkle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<br>
<br>
<br>
<h3>Yeni Yetenek Ekleme Sayfası</h3>
<form method="post">
    @Html.Label("Yetenek ID")
    @Html.TextBoxFor(x => x.ID, new { @class = "form-control" })
    <br />
    @Html.Label("Yetenek")
    @Html.TextBoxFor(x => x.Yetenek, new { @class = "form-control" })
    <br />
    @Html.Label("Oran")
    @Html.TextBoxFor(x => x.Oran, new { @class = "form-control" })
    <br />
    <button class="btn btn-info">Güncelle</button>
</form>



