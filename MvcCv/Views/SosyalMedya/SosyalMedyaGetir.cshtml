@model MvcCv.Models.Entity.TblSosyalMedya

@{
    ViewBag.Title = "Sosyal Medya Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<br />

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Sosyal Medya Hesabı Güncelle</h3>
    </div>

    <div class="card-body">

        <form method="post">

            @Html.HiddenFor(x => x.ID)

            <div class="form-group">
                @Html.Label("ID")
                @Html.TextBoxFor(x => x.ID, new { @class = "form-control", @readonly = "readonly" })
            </div>

            <br />

            <div class="form-group">
                @Html.Label("Sosyal Medya Adı")
                @Html.TextBoxFor(x => x.Ad, new { @class = "form-control" })
            </div>

            <br />

            <div class="form-group">
                @Html.Label("Link")
                @Html.TextBoxFor(x => x.Link, new { @class = "form-control" })
            </div>

            <br />

            <div class="form-group">
                @Html.Label("İkon")
                @Html.TextBoxFor(x => x.ikon, new { @class = "form-control" })
            </div>

            <br />

            <button type="submit" class="btn btn-success">
                Güncelle
            </button>

            <a href="/SosyalMedya/Index" class="btn btn-secondary">
                Geri Dön
            </a>

        </form>

    </div>
</div>