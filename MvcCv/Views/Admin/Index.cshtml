@model IEnumerable<MvcCv.Models.Entity.TblAdmin>
@{
    ViewBag.Title = "Admin Listesi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pt-4"></div>

<div class="card card-primary card-outline shadow-sm">
    <div class="card-header d-flex align-items-center">
        <h3 class="card-title mb-0">
            <i class="fas fa-user-shield mr-2 text-primary"></i>Admin Listesi
        </h3>
        <div class="ml-auto">
            <a href="/Admin/AdminEkle/" class="btn btn-success btn-sm">
                <i class="fas fa-plus mr-1"></i> Yeni Admin Ekle
            </a>
        </div>
    </div>

    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0">
            <thead class="thead-light">
                <tr>
                    <th style="width: 80px;">#</th>
                    <th>Kullanıcı Adı</th>
                    <th class="text-right" style="width: 220px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle">
                                <span class="badge badge-secondary">@item.ID</span>
                            </td>
                            <td class="align-middle">
                                <i class="fas fa-user-circle text-muted mr-2"></i>@item.KullaniciAdi
                            </td>
                            <td class="text-right align-middle">
                                <a href="/Admin/AdminDuzenle/@item.ID" class="btn btn-primary btn-sm">
                                    <i class="fas fa-edit mr-1"></i> Düzenle
                                </a>
                                <a href="/Admin/AdminSil/@item.ID" class="btn btn-danger btn-sm"
                                   onclick="return confirm('@item.KullaniciAdi adlı admini silmek istediğine emin misin?');">
                                    <i class="fas fa-trash-alt mr-1"></i> Sil
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">
                            <i class="fas fa-inbox fa-2x d-block mb-2"></i>
                            Henüz kayıtlı admin yok.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer text-muted small">
        Toplam <strong>@(Model?.Count() ?? 0)</strong> admin
    </div>
</div>