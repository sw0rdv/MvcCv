@{
    Layout = null;
    var kullanici = User.Identity.IsAuthenticated ? User.Identity.Name : "Misafir";
    var sayfaBasligi = ViewBag.Title ?? "Yönetim Paneli";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@sayfaBasligi | Sw0rdv Admin</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">    <link rel="stylesheet" href="/AdminLTE-3.0.4/dist/css/adminlte.min.css">
    <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700" rel="stylesheet">

    <style>
        .brand-link .brand-text {
            font-weight: 600 !important;
            letter-spacing: .5px;
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, #007bff, #6f42c1);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 15px;
            text-transform: uppercase;
        }

        .user-panel .info small {
            color: #adb5bd;
            display: block;
            font-size: 12px;
        }

        .nav-sidebar .nav-link {
            border-radius: 6px;
            transition: background .15s;
        }

        .nav-sidebar .nav-header {
            font-size: 11px;
            letter-spacing: 1px;
            color: #6c757d;
        }

        .content-header h1 {
            font-size: 1.6rem;
            font-weight: 600;
        }

        .content-wrapper {
            background: #f4f6f9;
        }
    </style>
</head>
<body class="hold-transition sidebar-mini layout-fixed layout-navbar-fixed">
    <div class="wrapper">

        <!-- Üst Bar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button" title="Menüyü aç/kapat">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="/Default/Index/" class="nav-link" target="_blank">
                        <i class="fas fa-external-link-alt mr-1"></i> Siteyi Görüntüle
                    </a>
                </li>
            </ul>

            <ul class="navbar-nav ml-auto">
                <li class="nav-item d-flex align-items-center mr-2">
                    <span class="text-muted">
                        <i class="fas fa-user-shield mr-1"></i> @kullanici
                    </span>
                </li>
                <li class="nav-item">
                    <a href="/Login/LogOut/" class="nav-link text-danger" title="Çıkış Yap">
                        <i class="fas fa-sign-out-alt"></i>
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Sol Menü -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="/Admin/Index/" class="brand-link">
                <img src="/AdminLTE-3.0.4/dist/img/AdminLTELogo.png" alt="Logo"
                     class="brand-image img-circle elevation-3" style="opacity: .85">
                <span class="brand-text">Sw0rdv Panel</span>
            </a>

            <div class="sidebar">
                <!-- Kullanıcı -->
                <div class="user-panel mt-3 pb-3 mb-3 d-flex align-items-center">
                    <div class="image pl-1">
                        <div class="user-avatar">@(string.IsNullOrEmpty(kullanici) ? "?" : kullanici.Substring(0, 1))</div>
                    </div>
                    <div class="info">
                        <a href="#" class="d-block">@kullanici</a>
                        <small><i class="fas fa-circle text-success" style="font-size:8px;"></i> Yönetici</small>
                    </div>
                </div>

                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column nav-child-indent" data-widget="treeview" role="menu" data-accordion="false">

                        <li class="nav-header">İÇERİK</li>

                        <li class="nav-item">
                            <a href="/Hakkimda/Index/" class="nav-link">
                                <i class="nav-icon fas fa-user-circle"></i>
                                <p>Hakkımda</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Egitim/Index/" class="nav-link">
                                <i class="nav-icon fas fa-graduation-cap"></i>
                                <p>Eğitimlerim</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Deneyim/Index/" class="nav-link">
                                <i class="nav-icon fas fa-briefcase"></i>
                                <p>Deneyimlerim</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Hobilerim/Index/" class="nav-link">
                                <i class="nav-icon fas fa-gamepad"></i>
                                <p>Hobilerim</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Yetenek/Index/" class="nav-link">
                                <i class="nav-icon fas fa-laptop-code"></i>
                                <p>Yeteneklerim</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Sertifika/Index/" class="nav-link">
                                <i class="nav-icon fas fa-award"></i>
                                <p>Sertifikalarım</p>
                            </a>
                        </li>

                        <li class="nav-header">İLETİŞİM</li>

                        <li class="nav-item">
                            <a href="/iletisim/Index/" class="nav-link">
                                <i class="nav-icon fas fa-envelope"></i>
                                <p>Mesajlar</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Sosyalmedya/Index/" class="nav-link">
                                <i class="nav-icon fas fa-share-alt"></i>
                                <p>Sosyal Medya</p>
                            </a>
                        </li>

                        <li class="nav-header">YÖNETİM</li>

                        <li class="nav-item">
                            <a href="/Admin/Index/" class="nav-link">
                                <i class="nav-icon fas fa-users-cog"></i>
                                <p>Adminler</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Default/Index/" class="nav-link" target="_blank">
                                <i class="nav-icon fas fa-globe"></i>
                                <p>Siteye Git</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Login/LogOut/" class="nav-link">
                                <i class="nav-icon fas fa-sign-out-alt text-danger"></i>
                                <p class="text-danger">Çıkış Yap</p>
                            </a>
                        </li>

                    </ul>
                </nav>
            </div>
        </aside>

        <!-- İçerik -->
        <div class="content-wrapper">
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2 align-items-center">
                        <div class="col-sm-6">
                            <h1 class="m-0 text-dark">@sayfaBasligi</h1>
                        </div>
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-right">
                                <li class="breadcrumb-item"><a href="/Admin/Index/"><i class="fas fa-home"></i> Panel</a></li>
                                <li class="breadcrumb-item active">@sayfaBasligi</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>

            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>

        <!-- Alt Bilgi -->
        <footer class="main-footer text-sm">
            <strong>&copy; @DateTime.Now.Year Sw0rdv.</strong> Tüm hakları saklıdır.
            <div class="float-right d-none d-sm-inline-block">
                <b>Admin Paneli</b>
            </div>
        </footer>
    </div>

    <script src="/AdminLTE-3.0.4/plugins/jquery/jquery.min.js"></script>
    <script src="/AdminLTE-3.0.4/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/AdminLTE-3.0.4/dist/js/adminlte.min.js"></script>

    <script>
        // Bulunulan sayfaya göre menüdeki linki aktif yap
        (function () {
            var yol = window.location.pathname.toLowerCase().split('/').filter(Boolean)[0] || '';
            $('.nav-sidebar a.nav-link').each(function () {
                var href = ($(this).attr('href') || '').toLowerCase().split('/').filter(Boolean)[0] || '';
                if (href && href === yol && href !== 'login' && href !== 'default') {
                    $(this).addClass('active');
                }
            });
        })();
    </script>
</body>
</html>